# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false

# --- Postgres (docker-compose default) ---
DATABASE_URL=postgresql://outbox:outbox@localhost:5432/outbox?schema=public

# --- Redis (docker-compose default) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Elasticsearch (docker-compose default) ---
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# --- BullMQ worker tuning ---
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Google OAuth (create at https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Slack OAuth (create at https://api.slack.com/apps) ---
# Redirect URL: http://localhost:4000/api/slack/callback
# Scopes: chat:write, incoming-webhook
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
