# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string

# --- Postgres (docker-compose default) ---
DATABASE_URL=postgresql://outbox:outbox@localhost:5432/outbox?schema=public
# prisma/schema.prisma references DIRECT_URL, so it must always be set to
# *something* or `prisma generate`/`migrate` will fail with "Environment
# variable not found". For plain Postgres (Docker, local install, Render
# Postgres) just repeat DATABASE_URL here. Only give it a different value
# when DATABASE_URL points at a connection pooler that can't run migrations
# (e.g. Supabase's pgbouncer transaction-mode pooler) — then this should be
# that same database's direct/session connection instead.
DIRECT_URL=postgresql://outbox:outbox@localhost:5432/outbox?schema=public

# --- Redis (docker-compose default) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" for managed free Redis that requires TLS (e.g. Upstash on Render — see README section 7.3). Leave unset for local/Docker Redis.
REDIS_TLS=

# --- Elasticsearch (docker-compose default) ---
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails
# Only needed for a secured cluster (e.g. Elastic Cloud Serverless). Leave
# unset for local/Docker ES, which runs with security disabled.
ELASTICSEARCH_API_KEY=

# --- BullMQ worker tuning ---
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Google OAuth (create at https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Slack OAuth (create at https://api.slack.com/apps) ---
# Redirect URL: http://localhost:4000/api/slack/callback
# Scopes: chat:write, incoming-webhook
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
